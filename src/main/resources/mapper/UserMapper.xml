<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.book.mapper.UserMapper">

    <select id="selectAll" resultType="com.book.entity.User">
        select id, username, password, name
        from `user`
        order by id
    </select>

    <select id="selectById" resultType="com.book.entity.User">
        select id, username, password, name
        from `user`
        where id = #{id}
    </select>

    <select id="selectByUsername" resultType="com.book.entity.User">
        select id, username, password, name
        from `user`
        where username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into `user` (username, password, name)
        values (#{username}, #{password}, #{name})
    </insert>

    <update id="update">
        update `user`
        set username = #{username},
            password = #{password},
            name = #{name}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from `user` where id = #{id}
    </delete>
</mapper>
